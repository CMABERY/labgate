#!/usr/bin/env bash
# Installed by labgate init. The base branch only receives promotions.
[[ -n "${LABGATE_PROMOTE:-}" ]] && exit 0
base="${LABGATE_BASE:-$(git config --get labgate.base || true)}"
if [[ -z "$base" ]]; then
  base=main
  git rev-parse --verify -q main >/dev/null || ! git rev-parse --verify -q master >/dev/null || base=master
fi
[[ "$(git symbolic-ref --short -q HEAD)" == "$base" ]] || exit 0
cat >&2 <<EOF
labgate: '$base' only receives promotions.
  build:    labgate start <branch>
  promote:  LABGATE_PROMOTE=1 git commit ...   (PROMOTE.md step 5)
  if this was a merge: git merge --abort
EOF
exit 1
