#!/usr/bin/env bash
# labgate — keep a project's progression out of its product.
#
#   labgate [-C <dir>] init                    create <repo>.lab beside this repo; install rules and hook (idempotent)
#   labgate [-C <dir>] start <branch>          new worktree at .worktrees/<branch> plus a handoff to fill in
#   labgate [-C <dir>] check <branch> [max]    fail if <branch> is not ready to promote
#   labgate [-C <dir>] close <branch>          after promotion: remove the worktree, branch and handoff
#   labgate [-C <dir>] audit                   fail if the main checkout has drifted from the model
#
# -C runs as if started in <dir> (anywhere inside the repo or one of its worktrees).
# Base branch: LABGATE_BASE, else git config labgate.base (set by init), else main.
# max defaults to 600 added lines.
set -euo pipefail

# Resolve $0 through symlinks without readlink -f (not on older BSD/macOS).
self="$0"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  [[ "$target" == /* ]] || target="$(dirname "$self")/$target"
  self="$target"
done
self="$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")"
templates="$(dirname "$self")/templates"

scaffold='(^|/)(plan|notes?|todo|changelog|scratch|debug|probe|tmp|wip|old|backup|copy)([^a-z]|$)'
# Bracketed so that this line does not match itself.
markers='(^|[^A-Za-z_])(T[O]DO|F[I]XME|X[X]X|H[A]CK|D[E]BUG|d[e]bugger)([^A-Za-z_]|$)|breakpoint\(\)|pdb\.set_trace|import p[d]b|console\.debug'

die() { printf 'labgate: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage_text() {
  cat <<'EOF'
usage:
  labgate [-C <dir>] init                    create <repo>.lab beside this repo; install rules and hook (idempotent)
  labgate [-C <dir>] start <branch>          new worktree at .worktrees/<branch> plus a handoff to fill in
  labgate [-C <dir>] check <branch> [max]    fail if <branch> is not ready to promote
  labgate [-C <dir>] close <branch>          after promotion: remove the worktree, branch and handoff
  labgate [-C <dir>] audit                   fail if the main checkout has drifted from the model

-C runs as if started in <dir>. Base branch: LABGATE_BASE, else git config labgate.base, else main.
EOF
}
usage() { usage_text >&2; exit 2; }

# Resolve the layout from anywhere inside the repo, including a worktree:
# common (.git dir), root (main checkout), name, lab, base.
locate() {
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || die "not inside a git repository"
  root="$(dirname "$common")"
  name="$(basename "$root")"
  lab="$(dirname "$root")/$name.lab"
  base="${LABGATE_BASE:-$(git config --get labgate.base || true)}"
  if [[ -z "$base" ]]; then
    base=main
    if ! git rev-parse --verify -q main >/dev/null && git rev-parse --verify -q master >/dev/null; then
      base=master
    fi
  fi
}

esc() { printf '%s' "$1" | sed 's/[&\/]/\\&/g'; }

# render <template>: substitute {{NAME}}, {{BASE}}, {{LAB}} and {{LABGATE}}.
render() {
  sed -e "s/{{NAME}}/$(esc "$name")/g" -e "s/{{BASE}}/$(esc "$base")/g" \
      -e "s/{{LAB}}/$(esc "$lab")/g"   -e "s/{{LABGATE}}/$(esc "$self")/g" "$1"
}

cmd_init() {
  locate
  if [[ ! -d "$lab" ]]; then
    mkdir -p "$lab"/{handoff,notes,plans,experiments,runs,prompts}
    render "$templates/lab.AGENTS.md" > "$lab/AGENTS.md"
    git -C "$lab" init -q -b main
    say "created $lab"
  fi
  # Procedure files are owned by labgate and refreshed on every init; AGENTS.md files are not.
  render "$templates/PROMOTE.md" > "$lab/PROMOTE.md"
  render "$templates/handoff.md" > "$lab/handoff/TEMPLATE.md"
  if [[ ! -e "$root/AGENTS.md" ]]; then
    render "$templates/repo.AGENTS.md" > "$root/AGENTS.md"
    say "installed $root/AGENTS.md; commit it with:"
    say "  git add AGENTS.md && LABGATE_PROMOTE=1 git commit -m 'Add labgate rules' -m 'Promoted-from: init'"
  fi
  mkdir -p "$common/info"
  grep -qsx '.worktrees/' "$common/info/exclude" || printf '.worktrees/\n' >> "$common/info/exclude"
  git config --get labgate.base  >/dev/null || git config labgate.base "$base"
  [[ -n "$(git config --get labgate.since || true)" ]] || git config labgate.since "$(git rev-parse --verify -q "$base" || true)"
  # A fast-forward merge creates no commit and so meets no hook; force a merge commit.
  if [[ -z "$(git config --get "branch.$base.mergeOptions" || true)" ]]; then
    git config "branch.$base.mergeOptions" --no-ff
  elif ! git config --get "branch.$base.mergeOptions" | grep -q -- --no-ff; then
    say "branch.$base.mergeOptions is already set; fast-forward merges into $base are not blocked (audit still sees them)"
  fi
  install_hook
  say "ok: $name and $lab (base: $base)"
}

# Refuse ordinary commits and merges on the base branch. Per clone, never tracked.
# git runs pre-merge-commit, not pre-commit, for a merge, so both are installed.
install_hook() {
  local h hook
  if [[ -n "$(git config --get core.hooksPath || true)" ]]; then
    say "core.hooksPath is set; not installing hooks"; return
  fi
  mkdir -p "$common/hooks"
  for h in pre-commit pre-merge-commit; do
    hook="$common/hooks/$h"
    if [[ -e "$hook" ]] && ! grep -q 'Installed by labgate' "$hook"; then
      say "$hook exists and is not labgate's; not installing it"
    else
      [[ -e "$hook" ]] || say "installed $hook: $base only receives promotions"
      cp "$templates/pre-commit" "$hook" && chmod +x "$hook"
    fi
  done
}

hook_ok() { [[ -x "$common/hooks/$1" ]] && grep -q 'Installed by labgate' "$common/hooks/$1"; }

cmd_audit() {
  locate
  local fail=0 hit since wt b h head tree
  git rev-parse --verify -q "$base" >/dev/null || die "no base branch: $base"
  head="$(git -C "$root" symbolic-ref --short -q HEAD || true)"
  [[ "$head" == "$base" ]] || { echo "main checkout is on '${head:-a detached HEAD}', not $base"; fail=1; }
  tree="$(git -C "$root" ls-tree -r --name-only "$base")"
  [[ -d "$lab" ]] || { echo "no lab at $lab (run labgate init)"; fail=1; }
  [[ -e "$root/AGENTS.md" ]] || { echo "no $root/AGENTS.md (run labgate init)"; fail=1; }
  grep -qsx '.worktrees/' "$common/info/exclude" || { echo ".worktrees/ not excluded (run labgate init)"; fail=1; }
  if [[ -z "$(git config --get core.hooksPath || true)" ]]; then
    hook_ok pre-commit && hook_ok pre-merge-commit || { echo "labgate hooks missing (run labgate init)"; fail=1; }
  fi

  hit="$(printf '%s\n' "$tree" | grep -Ei "$scaffold" || true)"
  [[ -n "$hit" ]] && { echo "scaffolding-named files on $base:"; echo "$hit"; fail=1; }

  hit="$(printf '%s\n' "$tree" | grep -v / | grep -E '\.md$' | grep -Ev '^(README|AGENTS)\.md$|^LICENSE' || true)"
  [[ -n "$hit" ]] && { echo "top-level markdown other than README.md on $base:"; echo "$hit"; fail=1; }

  printf '%s\n' "$tree" | grep -q '^\.worktrees/' && { echo ".worktrees/ is tracked on $base"; fail=1; }

  # Every commit on base since init must be a promotion, recognised by the
  # Promoted-from trailer that PROMOTE.md step 5 writes.
  since="$(git config --get labgate.since || true)"
  hit="$(git -C "$root" log -z --first-parent --format='%h %s%n%(trailers:key=Promoted-from,valueonly)' \
           ${since:+"$since.."}"$base" 2>/dev/null \
         | awk 'BEGIN{RS="\0"} {split($0,L,"\n"); if (L[2] !~ /[^ \t]/) print L[1]}' || true)"
  [[ -n "$hit" ]] && { echo "commits on $base since labgate init without a Promoted-from trailer (not promotions):"; echo "$hit"; fail=1; }

  while IFS= read -r wt; do
    b="${wt#"$root/.worktrees/"}"
    [[ -f "$lab/handoff/$b.md" ]] || { echo "worktree without handoff: $b"; fail=1; }
  done < <(git -C "$root" worktree list --porcelain | sed -n 's/^worktree //p' | grep -F "$root/.worktrees/" || true)
  for h in "$lab"/handoff/*.md; do
    [[ -f "$h" ]] || continue
    b="$(basename "$h" .md)"; [[ "$b" != TEMPLATE ]] || continue
    [[ -d "$root/.worktrees/$b" ]] || { echo "handoff without worktree: $b (promoted? then labgate close $b)"; fail=1; }
  done

  (( fail )) && exit 1
  echo "ok: $name follows the model"
}

cmd_start() {
  locate
  local branch="${1:-}" wt handoff
  [[ -n "$branch" ]] || usage
  [[ "$branch" != */* ]] || die "branch names containing / are not supported"
  [[ -d "$lab" ]] || die "no lab at $lab; run labgate init first"
  wt="$root/.worktrees/$branch"
  [[ ! -e "$wt" ]] || die "$wt already exists"
  git -C "$root" worktree add -q "$wt" -b "$branch" "$base"
  handoff="$lab/handoff/$branch.md"
  [[ -e "$handoff" ]] || sed "s/<branch>/$(esc "$branch")/" "$lab/handoff/TEMPLATE.md" > "$handoff"
  say "worktree: $wt"
  say "handoff:  $handoff"
}

cmd_check() {
  locate
  local branch="${1:-}" max="${2:-600}" range added handoff hit f n fail=0
  [[ -n "$branch" ]] || usage
  git rev-parse --verify -q "$branch" >/dev/null || die "no such branch: $branch"
  git rev-parse --verify -q "$base"   >/dev/null || die "no base branch: $base (set LABGATE_BASE or git config labgate.base)"
  range="$base...$branch"
  added="$(git diff --name-only --diff-filter=A "$range")"

  # The template's "<...>" lines define the handoff: none may survive verbatim,
  # and each of their "Field:" prefixes must be present with something after it.
  handoff="$lab/handoff/$branch.md"
  if [[ ! -f "$handoff" ]]; then
    echo "no handoff: $handoff (copy $lab/handoff/TEMPLATE.md and fill it in)"; fail=1
  else
    if grep -Fxq -f <(grep '<' "$lab/handoff/TEMPLATE.md" | grep -v '^#') "$handoff"; then
      echo "handoff still contains unfilled template lines: $handoff"; fail=1
    fi
    while IFS= read -r field; do
      awk -v f="$field" 'index($0,f)==1 && substr($0,length(f)+1) ~ /[^ \t]/ {ok=1} END {exit !ok}' "$handoff" \
        || { echo "handoff field missing or empty: $field"; fail=1; }
    done < <(grep '<' "$lab/handoff/TEMPLATE.md" | grep -v '^#' | grep -o '^[^:<]*:' || true)
  fi

  hit="$(printf '%s\n' "$added" | grep -Ei "$scaffold" || true)"
  [[ -n "$hit" ]] && { echo "scaffolding-named files:"; echo "$hit"; fail=1; }

  hit="$(comm -23 <(printf '%s\n' "$added" | grep / | cut -d/ -f1 | sort -u || true) \
                  <(git ls-tree --name-only "$base" | sort))"
  [[ -n "$hit" ]] && { echo "new top-level directories:"; echo "$hit"; fail=1; }

  hit="$(printf '%s\n' "$added" | grep -v / | grep -E '\.md$' | grep -Ev '^(README|AGENTS)\.md$|^LICENSE' || true)"
  [[ -n "$hit" ]] && { echo "top-level markdown other than README.md:"; echo "$hit"; fail=1; }

  while IFS= read -r f; do
    [[ -n "$f" && "$f" != *.md ]] || continue
    hit="$(git diff -U0 "$range" -- "$f" | grep -E '^\+[^+]' | cut -c2- | grep -E "$markers" || true)"
    [[ -n "$hit" ]] && { echo "debug or unfinished markers in $f:"; printf '%s\n' "$hit" | sed 's/^/  /'; fail=1; }
  done < <(git diff --name-only "$range")

  n="$(git diff --shortstat "$range" | grep -oE '[0-9]+ insertion' | grep -oE '^[0-9]+' || echo 0)"
  (( n > max )) && { echo "adds $n lines (> $max)"; fail=1; }
  n="$(git diff --shortstat "$range" | grep -oE '[0-9]+ deletion' | grep -oE '^[0-9]+' || echo 0)"
  (( n == 0 )) && echo "note: removes nothing; a change that only adds deserves a second look"

  (( fail )) && exit 1
  echo "ok: $branch is ready to promote onto $base"
}

# A squash merge leaves no trace git can verify, so the promotion's decision
# note is the receipt that authorises deleting the branch.
cmd_close() {
  locate
  local branch="${1:-}" wt handoff receipt elsewhere
  [[ -n "$branch" ]] || usage
  wt="$root/.worktrees/$branch"; handoff="$lab/handoff/$branch.md"
  receipt="$(find "$lab/notes" -maxdepth 1 -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$branch.md" 2>/dev/null | sort | tail -n 1)"
  [[ -n "$receipt" ]] || die "no decision note $lab/notes/YYYY-MM-DD-$branch.md; write it (PROMOTE.md step 7) before closing"
  elsewhere="$(git -C "$root" worktree list --porcelain \
    | awk -v b="branch refs/heads/$branch" -v wt="$wt" '/^worktree /{w=substr($0,10)} $0==b && w!=wt {print w}')"
  [[ -z "$elsewhere" ]] || die "$branch is checked out in $elsewhere; not closing"
  [[ ! -d "$wt" ]] || git -C "$root" worktree remove "$wt"
  ! git rev-parse --verify -q "$branch" >/dev/null || git -C "$root" branch -qD "$branch"
  [[ ! -f "$handoff" ]] || rm "$handoff"
  say "closed $branch; receipt: $receipt"
}

if [[ "${1:-}" == -C ]]; then
  cd "${2:?-C needs a directory}" || die "cannot cd to $2"
  shift 2
fi
case "${1:-}" in
  -h|--help|help) usage_text ;;
  init)  shift; cmd_init "$@" ;;
  start) shift; cmd_start "$@" ;;
  check) shift; cmd_check "$@" ;;
  close) shift; cmd_close "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  *)     usage ;;
esac
