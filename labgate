#!/usr/bin/env bash
# labgate — keep a project's progression out of its product.
#
#   labgate [-C <dir>] init                    create <repo>.lab beside this repo and install the rules (idempotent)
#   labgate [-C <dir>] start <branch>          new worktree at .worktrees/<branch> plus a handoff to fill in
#   labgate [-C <dir>] check <branch> [max]    fail if <branch> is not ready to promote
#
# -C runs as if started in <dir> (anywhere inside the repo or one of its worktrees).
# Base branch: LABGATE_BASE, else git config labgate.base (set by init), else main.
# max defaults to 600 added lines.
set -euo pipefail

self="$(readlink -f "$0")"
templates="$(dirname "$self")/templates"

scaffold='(^|/)(plan|notes?|todo|changelog|scratch|debug|probe|tmp|wip|old|backup|copy)([^a-z]|$)'
# Bracketed so that this line does not match itself.
markers='(^|[^A-Za-z_])(T[O]DO|F[I]XME|X[X]X|H[A]CK|D[E]BUG|d[e]bugger)([^A-Za-z_]|$)|breakpoint\(\)|pdb\.set_trace|import p[d]b|console\.debug'

die() { printf 'labgate: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() {
  cat >&2 <<'EOF'
usage:
  labgate [-C <dir>] init                    create <repo>.lab beside this repo and install the rules (idempotent)
  labgate [-C <dir>] start <branch>          new worktree at .worktrees/<branch> plus a handoff to fill in
  labgate [-C <dir>] check <branch> [max]    fail if <branch> is not ready to promote
EOF
  exit 2
}

# Resolve the layout from anywhere inside the repo, including a worktree:
# common (.git dir), root (main checkout), name, lab, base.
locate() {
  local d
  d="$(git rev-parse --git-common-dir 2>/dev/null)" || die "not inside a git repository"
  common="$(readlink -f "$d")"
  root="$(dirname "$common")"
  name="$(basename "$root")"
  lab="$(dirname "$root")/$name.lab"
  base="${LABGATE_BASE:-$(git config --get labgate.base || true)}"
  if [[ -z "$base" ]]; then
    base=main
    if ! git rev-parse --verify -q main >/dev/null && git rev-parse --verify -q master >/dev/null; then
      base=master
    fi
  fi
}

esc() { printf '%s' "$1" | sed 's/[&\/]/\\&/g'; }

# render <template>: substitute {{NAME}}, {{BASE}}, {{LAB}} and {{LABGATE}}.
render() {
  sed -e "s/{{NAME}}/$(esc "$name")/g" -e "s/{{BASE}}/$(esc "$base")/g" \
      -e "s/{{LAB}}/$(esc "$lab")/g"   -e "s/{{LABGATE}}/$(esc "$self")/g" "$1"
}

cmd_init() {
  locate
  if [[ ! -d "$lab" ]]; then
    mkdir -p "$lab"/{handoff,notes,plans,experiments,runs,prompts}
    render "$templates/lab.AGENTS.md" > "$lab/AGENTS.md"
    git -C "$lab" init -q -b main
    say "created $lab"
  fi
  # Procedure files are owned by labgate and refreshed on every init; AGENTS.md files are not.
  render "$templates/PROMOTE.md" > "$lab/PROMOTE.md"
  render "$templates/handoff.md" > "$lab/handoff/TEMPLATE.md"
  if [[ ! -e "$root/AGENTS.md" ]]; then
    render "$templates/repo.AGENTS.md" > "$root/AGENTS.md"
    say "installed $root/AGENTS.md; commit it"
  fi
  mkdir -p "$common/info"
  grep -qsx '.worktrees/' "$common/info/exclude" || printf '.worktrees/\n' >> "$common/info/exclude"
  git config --get labgate.base  >/dev/null || git config labgate.base "$base"
  git config --get labgate.since >/dev/null || git config labgate.since "$(git rev-parse --verify -q "$base" || true)"
  say "ok: $name and $lab (base: $base)"
}

cmd_start() {
  locate
  local branch="${1:-}" wt handoff
  [[ -n "$branch" ]] || usage
  [[ "$branch" != */* ]] || die "branch names containing / are not supported"
  [[ -d "$lab" ]] || die "no lab at $lab; run labgate init first"
  wt="$root/.worktrees/$branch"
  [[ ! -e "$wt" ]] || die "$wt already exists"
  git -C "$root" worktree add -q "$wt" -b "$branch" "$base"
  handoff="$lab/handoff/$branch.md"
  [[ -e "$handoff" ]] || sed "s/<branch>/$(esc "$branch")/" "$lab/handoff/TEMPLATE.md" > "$handoff"
  say "worktree: $wt"
  say "handoff:  $handoff"
}

cmd_check() {
  locate
  local branch="${1:-}" max="${2:-600}" range added handoff hit f n fail=0
  [[ -n "$branch" ]] || usage
  git rev-parse --verify -q "$branch" >/dev/null || die "no such branch: $branch"
  git rev-parse --verify -q "$base"   >/dev/null || die "no base branch: $base (set LABGATE_BASE or git config labgate.base)"
  range="$base...$branch"
  added="$(git diff --name-only --diff-filter=A "$range")"

  handoff="$lab/handoff/$branch.md"
  if [[ ! -f "$handoff" ]]; then
    echo "no handoff: $handoff (copy $lab/handoff/TEMPLATE.md and fill it in)"; fail=1
  elif grep -Fxq -f <(grep '<' "$lab/handoff/TEMPLATE.md" | grep -v '^#') "$handoff"; then
    echo "handoff still contains unfilled template lines: $handoff"; fail=1
  fi

  hit="$(printf '%s\n' "$added" | grep -Ei "$scaffold" || true)"
  [[ -n "$hit" ]] && { echo "scaffolding-named files:"; echo "$hit"; fail=1; }

  hit="$(comm -23 <(printf '%s\n' "$added" | grep / | cut -d/ -f1 | sort -u || true) \
                  <(git ls-tree --name-only "$base" | sort))"
  [[ -n "$hit" ]] && { echo "new top-level directories:"; echo "$hit"; fail=1; }

  hit="$(printf '%s\n' "$added" | grep -v / | grep -E '\.md$' | grep -Ev '^(README|AGENTS)\.md$|^LICENSE' || true)"
  [[ -n "$hit" ]] && { echo "top-level markdown other than README.md:"; echo "$hit"; fail=1; }

  while IFS= read -r f; do
    [[ -n "$f" && "$f" != *.md ]] || continue
    hit="$(git diff -U0 "$range" -- "$f" | grep -E '^\+[^+]' | cut -c2- | grep -E "$markers" || true)"
    [[ -n "$hit" ]] && { echo "debug or unfinished markers in $f:"; printf '%s\n' "$hit" | sed 's/^/  /'; fail=1; }
  done < <(git diff --name-only "$range")

  n="$(git diff --shortstat "$range" | grep -oE '[0-9]+ insertion' | grep -oE '^[0-9]+' || echo 0)"
  (( n > max )) && { echo "adds $n lines (> $max)"; fail=1; }
  n="$(git diff --shortstat "$range" | grep -oE '[0-9]+ deletion' | grep -oE '^[0-9]+' || echo 0)"
  (( n == 0 )) && echo "note: removes nothing; a change that only adds deserves a second look"

  (( fail )) && exit 1
  echo "ok: $branch is ready to promote onto $base"
}

if [[ "${1:-}" == -C ]]; then
  cd "${2:?-C needs a directory}" || die "cannot cd to $2"
  shift 2
fi
case "${1:-}" in
  init)  shift; cmd_init "$@" ;;
  start) shift; cmd_start "$@" ;;
  check) shift; cmd_check "$@" ;;
  *)     usage ;;
esac
